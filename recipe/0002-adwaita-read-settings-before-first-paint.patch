+    // Read the settings before the window is first painted, so that it does not
+    // show with the default colors and buttons and then change a moment later.
+    // Wait only briefly: if the portal is slow to answer, ask again without
+    // blocking and apply the settings when they arrive.
+    const QDBusReply<QMap<QString, QVariantMap>> reply = connection.call(message, QDBus::Block, 200);
+    if (reply.isValid()) {
+        applySettings(reply.value());
+    } else {
+        QDBusPendingCall pendingCall = connection.asyncCall(message);
+        QDBusPendingCallWatcher *watcher = new QDBusPendingCallWatcher(pendingCall, this);
+        QObject::connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+            QDBusPendingReply<QMap<QString, QVariantMap>> reply = *watcher;
+            if (reply.isValid())
+                applySettings(reply.value());
+            watcher->deleteLater();
+        });
+    }
 
     QDBusConnection::sessionBus().connect(QString(), "/org/freedesktop/portal/desktop"_L1,
                                           "org.freedesktop.portal.Settings"_L1, "SettingChanged"_L1, this,
                                           SLOT(settingChanged(QString,QString,QDBusVariant)));
+}
 
